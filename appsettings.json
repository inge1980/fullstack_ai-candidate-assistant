{
  "GitHub": {
    "Owner": "inge1980",
    "Repository": "fullstack_ai-candidate-assistant",
    "ProjectsFolder": "knowledge/projects",
    "Branch": "main"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "Postgres": ""
  },

  "Knowledge": {
    "RootPath": "knowledge/projects",
    "ExcludedFiles": [
      "_template_project.md"
    ]
  },

  "Embeddings": {
    "Provider": "Ollama",
    "Model": "qllama/bge-small-en-v1.5:latest",
    "Dimensions": 384
  },

  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "EmbedEndpoint": "/api/embed"
  },

  "Llm": {
    "MaxOutputTokens": 2048,
    "ThinkingLevel": "minimal",
    "ReasoningEffort": "low",
    "Providers": [
      {
        "Name": "Groq",
        "Models": [
          "openai/gpt-oss-120b"
        ],
        "TimeoutSeconds": 20
      },
      {
        "Name": "OpenRouter",
        "Models": [
          "google/gemma-4-26b-a4b-it:free",
          "google/gemma-4-31b-it:free",
          "nvidia/nemotron-3.5-lightning:free",
          "openai/gpt-oss-20b:free",
          "nvidia/nemotron-3-super-120b-a12b:free"
        ],
        "TimeoutSeconds": 20
      },
      {
        "Name": "Google",
        "Models": [
          "gemini-3.6-flash"
        ],
        "TimeoutSeconds": 15
      }
    ]
  },

  "Google": {
    "BaseUrl": "https://generativelanguage.googleapis.com",
    "ApiVersion": "v1"
  },

  "Groq": {
    "BaseUrl": "https://api.groq.com/openai/v1"
  },

  "OpenRouter": {
    "BaseUrl": "https://openrouter.ai/api/v1"
  },

  "Cerebras": {
    "BaseUrl": "https://api.cerebras.ai/v1"
  }
}